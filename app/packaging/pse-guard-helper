#!/bin/bash
# PSE Riemann guardian helper — the ONLY thing the narrow sudoers rule allows.
# Runs as root via:  sudo -n /usr/lib/pse-riemann/pse-guard-helper <verb> <arg>
# Every argument is validated here; anything else exits 2 without doing anything.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

valid_ip() {
  local ip="$1"
  if [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    for o in "${BASH_REMATCH[@]:1}"; do (( o <= 255 )) || return 1; done
    [[ "$ip" != 0.* && "$ip" != 127.* && "$ip" != 255.255.255.255 ]] || return 1
    return 0
  fi
  # IPv6: hex groups and colons only, not loopback / unspecified
  [[ "$ip" =~ ^[0-9a-fA-F:]{2,39}$ && "$ip" == *:* && "$ip" != "::1" && "$ip" != "::" ]]
}

verb="${1:-}"; arg="${2:-}"
case "$verb" in
  check)
    if command -v ufw >/dev/null; then
      st=$(ufw status 2>/dev/null | head -1 || true)
      echo "ok ufw: ${st}"
    else
      echo "ok ufw: nije instaliran"
    fi ;;
  block-ip)
    valid_ip "$arg" || { echo "neispravna adresa" >&2; exit 2; }
    ufw insert 1 deny from "$arg" to any comment 'pse-riemann 24h' ;;
  unblock-ip)
    valid_ip "$arg" || { echo "neispravna adresa" >&2; exit 2; }
    ufw delete deny from "$arg" to any || true ;;
  kill-session)
    [[ "$arg" =~ ^[0-9]{2,8}$ ]] || { echo "neispravan PID" >&2; exit 2; }
    comm=$(cat "/proc/$arg/comm" 2>/dev/null || true)
    [[ "$comm" == sshd* ]] || { echo "PID $arg nije sshd" >&2; exit 2; }
    kill -TERM "$arg" ;;
  *)
    echo "nepoznata naredba" >&2; exit 2 ;;
esac
