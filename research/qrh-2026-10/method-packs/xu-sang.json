{
  "name": "xu-sang",
  "family": "xs",
  "source": "arxiv:2610.15291",
  "claimed_B": 0.8748867,
  "dlo": 0.125,
  "tol": 1e-07,
  "exact_poly": "133488*B**4 - 376596*B**3 + 384534*B**2 - 167541*B + 26231",
  "note": "Xu-Sang, 15.10.2026 (arXiv 2610.15291v2). Rad tvrdi B1=8748867/10^7 (certifikovan racionalni izbor, ne optimum). Optimum njihovog sistema (nas racun, nerecenzirano) = 0.874886647040, korijen kvartike gore; razlika 5.3e-8 je u tol. Sistem: eq. full-exponent/endpoint (delta>=1/8) i small-delta-endpoint; zidovi iz par. 6.2 (bez B>0.87 i kappa-raspona, koji su izbor stage-a).",
  "tags": [
    "qrh",
    "xu-sang"
  ],
  "system": {
    "defs": [
      [
        "h",
        "(1 + b + 3*ell)/2"
      ],
      [
        "lx",
        "(1 - b - ell)/2"
      ],
      [
        "ly",
        "(1 + b - ell)/2"
      ],
      [
        "cR",
        "2/(3*kappa)"
      ],
      [
        "D",
        "3 - (1 + cR)*x"
      ],
      [
        "P",
        "(2 - cR*x)*(1 - x)"
      ],
      [
        "J",
        "(5/6 - delta)*D + delta*P"
      ],
      [
        "R",
        "1 - delta + (5/6 - delta)*delta*P/(2*J)"
      ],
      [
        "c",
        "1/(3*kappa)"
      ]
    ],
    "branches": [
      {
        "E": "-1/4 + b/6 + 5*ell/4 + delta/2 + delta*x*(ell + c*(h/4 - ly/2)) - (3/4)*h*(1 - R)",
        "delta": [
          0.125,
          0.8333333333333334
        ]
      },
      {
        "E": "-1/4 + b/6 + 5*ell/4 + delta/2 + ell*delta*x*(1/2 + 2*ell/h) - (3/4)*h*(1 - R)",
        "delta": [
          1e-06,
          0.125
        ]
      }
    ],
    "x_grid": [
      0.5
    ],
    "line": "11/12 - ell/4",
    "licence": "2*B - 1",
    "b_range": [
      0,
      0.3
    ],
    "ell_range": [
      0,
      0.6
    ],
    "walls": [
      "6*kappa*ell > 3/4",
      "ell/h < 1/(6*kappa)",
      "lx > ell",
      "ly - ell > 11*b/6",
      "ly < 1/2",
      "ly > h/2",
      "ell <= 1/5"
    ]
  }
}
